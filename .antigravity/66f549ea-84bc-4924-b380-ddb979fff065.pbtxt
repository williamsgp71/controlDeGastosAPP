        }
        lines {
          text: ") {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    var isExpenseSelected by remember { mutableStateOf(true) } // true=Nuevo Gasto, false=Nuevo Ingreso"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    var amount by remember { mutableStateOf(\"\") }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    var selectedCurrency by remember { mutableStateOf(\"S/ (PEN)\") }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    var description by remember { mutableStateOf(\"\") }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    var expandedCat by remember { mutableStateOf(false) }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    // Sort and filter active lists"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    val filteredCategories = categoriesBytes.filter { it.isExpense == isExpenseSelected }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    var selectedCategory by remember { mutableStateOf<Category?>(null) }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    // Reset categorization state if lists change"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    LaunchedEffect(isExpenseSelected, categoriesBytes) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        selectedCategory = filteredCategories.firstOrNull()"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
