          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        // TOP CUSTOM HEADER (Title, API REST CENTRALIZADA Badge, user profile williams, Cerrar Sesi\303\263n)"
