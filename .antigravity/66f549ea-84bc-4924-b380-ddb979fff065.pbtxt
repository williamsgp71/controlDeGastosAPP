        lines {
          text: "fun TransactionCreator("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    viewModel: ExpenseViewModel,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
